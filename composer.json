{
    "name": "hongxunpan/eloquent-query-dsl",
    "description": "Reusable Eloquent query DSL (Domain-Specific Language) engine for list search, filter, between, sort and pagination",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/HongXunPan/eloquent-query-dsl",
    "keywords": [
        "eloquent",
        "query-dsl",
        "filter",
        "sort",
        "pagination"
    ],
    "support": {
        "issues": "https://github.com/HongXunPan/eloquent-query-dsl/issues",
        "source": "https://github.com/HongXunPan/eloquent-query-dsl"
    },
    "autoload": {
        "psr-4": {
            "HongXunPan\\EloquentQueryDsl\\": "src/"
        }
    },
    "authors": [
        {
            "name": "HongXunPan",
            "email": "me@kangxuanpeng.com"
        }
    ],
    "require": {
        "php": "^8.0.20",
        "illuminate/database": "^9.52 || ^10.0 || ^11.0 || ^12.0"
    },
    "scripts": {
        "test:skeleton": "@php tests/TestRunner.php",
        "test:input-parser": "@php tests/InputParserRegression.php",
        "test:query-dsl": "@php tests/QueryDslRegression.php",
        "test:core": "@php tests/CoreRegression.php",
        "test": [
            "@test:phpunit",
            "@test:legacy"
        ],
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --error-format=table",
        "cs:check": "@php scripts/check_code_style.php",
        "quality": [
            "@test",
            "@analyse",
            "@cs:check"
        ],
        "test:legacy": [
            "@test:skeleton",
            "@test:input-parser",
            "@test:query-dsl",
            "@test:core"
        ],
        "test:phpunit": "phpunit --configuration=phpunit.xml.dist"
    },
    "autoload-dev": {
        "psr-4": {
            "HongXunPan\\EloquentQueryDsl\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6"
    }
}
