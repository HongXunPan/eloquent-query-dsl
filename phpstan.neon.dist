parameters:
    level: 8
    phpVersion: 80020
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            - vendor

    # Illuminate 10+ exposes Eloquent Builder / relations as generic types, while Illuminate 9 does not.
    # Source PHPDoc keeps generic forms for downstream analyzers; these ignores keep the
    # package-level Illuminate 9 quality gate compatible.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#contains generic type Illuminate\\Database\\Eloquent\\Builder<.*> but class Illuminate\\Database\\Eloquent\\Builder is not generic#'
        - '#contains generic type Illuminate\\Database\\Eloquent\\Relations\\HasMany<.*> but class Illuminate\\Database\\Eloquent\\Relations\\HasMany is not generic#'
